{%- comment -%}
  Fuly · Producto sticky
  Bloque de producto para landings: galería fija al hacer scroll + info de compra.
  - Producto: se elige en la configuración de la sección.
  - Reseñas: lee product.metafields.reviews.rating_count (igual que main-product).
  - Suscripción: agrega el bloque de app "Suscripciones Fuly Kids · Subscription widget"
    (Add block → Apps). Queda dentro del formulario de compra, igual que en la PDP.
  - El orden de etiqueta, título, reseñas, precio, app, compra, descripción y acordeones
    se cambia arrastrando bloques.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign product = s.product
  if product != blank
    assign variant = product.selected_or_first_available_variant
    assign reviews_count = product.metafields.reviews.rating_count
    if reviews_count == blank
      assign reviews_count = 0
    endif
    assign form_id = 'fps-form-' | append: sid
  endif
-%}

<style>
  #fps-{{ sid }} {
    --fps-ink: var(--fuly-cartoon-black, #000);
    --fps-yellow: var(--fuly-yellow-spark, #FAE64B);
    --fps-border: var(--fuly-border, 3px solid #000);
    --fps-shadow: 4px 4px 0 var(--fps-ink);
    --fps-shadow-sm: var(--fuly-shadow-sm, 3px 3px 0 #000);
    --fps-heading: var(--fuly-font-heading, "PP Pangram Sans Rounded", "Arial Narrow", Helvetica, sans-serif);
    --fps-muted: var(--fuly-muted-text, #6b6b6b);
    --fps-top: {{ s.sticky_offset }}px;
    background: {{ s.bg_color }};
    padding: {{ s.padding_y }}px 0;
    color: var(--fps-ink);
    overflow-x: clip; /* corta cualquier desborde lateral sin romper la imagen fija */
  }
  #fps-{{ sid }} .fps__inner {
    max-width: {{ s.max_width }}px;
    margin: 0 auto;
    padding: 0 32px;
    box-sizing: border-box;
    display: grid;
    /* minmax(0, …) evita que fotos o textos largos empujen la columna y se corte todo */
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 56px;
    align-items: start;
  }
  #fps-{{ sid }} .fps__gallery,
  #fps-{{ sid }} .fps__info { min-width: 0; max-width: 100%; }
  #fps-{{ sid }} .fps__info { overflow-wrap: break-word; }
  #fps-{{ sid }} .fps__info img,
  #fps-{{ sid }} .fps__info iframe,
  #fps-{{ sid }} .fps__info table { max-width: 100%; }

  /* Galería sticky */
  #fps-{{ sid }} .fps__gallery {
    position: sticky;
    top: var(--fps-top);
    width: 100%;
    max-width: {{ s.image_max_desktop }}px;
    justify-self: end;
  }
  /* Carrusel: se desliza con el dedo; en escritorio lo mueven las miniaturas */
  #fps-{{ sid }} .fps__track {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 0 6px 6px 0; /* deja ver la sombra cartoon */
  }
  #fps-{{ sid }} .fps__track::-webkit-scrollbar { display: none; }
  #fps-{{ sid }} .fps__slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    aspect-ratio: 1 / 1;
    background: #fff;
    border: var(--fps-border);
    border-radius: 16px;
    box-shadow: var(--fps-shadow);
    overflow: hidden;
    display: flex; align-items: center; justify-content: center;
    box-sizing: border-box;
  }
  #fps-{{ sid }} .fps__slide img { width: 100%; height: 100%; object-fit: contain; display: block; }

  #fps-{{ sid }} .fps__nav {
    display: none;
    align-items: center; justify-content: center;
    gap: 20px;
    margin-top: 12px;
    font-size: 14px; font-weight: 600;
  }
  #fps-{{ sid }} .fps__arrow {
    width: 36px; height: 36px; padding: 0;
    display: inline-flex; align-items: center; justify-content: center;
    background: none; border: 0; cursor: pointer; color: inherit;
  }
  #fps-{{ sid }} .fps__arrow::before {
    content: "";
    width: 8px; height: 8px;
    border-right: 2px solid currentColor; border-bottom: 2px solid currentColor;
  }
  #fps-{{ sid }} .fps__arrow--prev::before { transform: rotate(135deg); margin-left: 4px; }
  #fps-{{ sid }} .fps__arrow--next::before { transform: rotate(-45deg); margin-right: 4px; }
  #fps-{{ sid }} .fps__arrow[disabled] { opacity: .3; cursor: default; }
  #fps-{{ sid }} .fps__thumbs {
    display: flex; gap: 12px;
    margin-top: 16px;
    overflow-x: auto;
    padding: 2px 6px 8px 2px;
    scrollbar-width: thin;
  }
  #fps-{{ sid }} .fps__thumb {
    flex: 0 0 72px; height: 72px; padding: 0;
    background: #fff;
    border: 2px solid var(--fps-ink);
    border-radius: 10px;
    overflow: hidden; cursor: pointer;
    opacity: .55;
    transition: opacity 120ms ease-out, box-shadow 120ms ease-out;
  }
  #fps-{{ sid }} .fps__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #fps-{{ sid }} .fps__thumb[aria-current="true"] { opacity: 1; box-shadow: var(--fps-shadow-sm); }

  /* Info */
  #fps-{{ sid }} .fps__info > * + * { margin-top: 16px; }
  #fps-{{ sid }} .fps__badge {
    display: inline-block;
    padding: 6px 12px;
    background: var(--fps-yellow);
    border: var(--fps-border);
    border-radius: 8px;
    box-shadow: var(--fps-shadow-sm);
    font-size: 12px; font-weight: 700;
    letter-spacing: .05em; text-transform: uppercase;
  }
  #fps-{{ sid }} .fps__title {
    margin: 4px 0 0;
    font-family: var(--fps-heading) !important;
    text-transform: uppercase;
    font-size: clamp(30px, 3.6vw, 48px);
    line-height: .95;
    overflow-wrap: anywhere;
  }
  #fps-{{ sid }} .fps__rating { display: flex; align-items: center; gap: 8px; margin-top: 8px !important; }
  #fps-{{ sid }} .fps__stars { font-size: 18px; line-height: 1; letter-spacing: 1px; color: var(--fps-yellow); -webkit-text-stroke: .5px #000; }
  #fps-{{ sid }} .fps__rating-count { font-family: var(--fps-heading); font-size: 16px; color: var(--fps-muted); }
  #fps-{{ sid }} .fps__price { font-family: var(--fps-heading); font-size: 32px; font-weight: 800; display: flex; gap: 12px; align-items: baseline; }
  #fps-{{ sid }} .fps__price s { font-size: 18px; font-weight: 400; color: var(--fps-muted); }

  #fps-{{ sid }} .fps__variant select {
    width: 100%; height: 48px; padding: 0 16px;
    border: 2px solid var(--fps-ink); border-radius: 10px;
    background: #fff; font-weight: 700; font-size: 15px;
  }

  #fps-{{ sid }} .fps__buy { display: flex; gap: 12px; align-items: stretch; }
  #fps-{{ sid }} .fps__qty {
    flex: 0 0 auto;
    display: flex; align-items: center;
    border: 2px solid var(--fps-ink); border-radius: 999px;
    overflow: hidden; background: #fff;
  }
  #fps-{{ sid }} .fps__qty button { width: 40px; height: 48px; padding: 0; background: none; border: 0; box-shadow: none; font-size: 18px; cursor: pointer; color: inherit; }
  /* !important: el tema le pone borde, padding y alto a todos los inputs y tapaba el número */
  #fps-{{ sid }} .fps__qty input {
    width: 36px !important; min-width: 0 !important; height: 48px !important;
    margin: 0 !important; padding: 0 !important;
    border: 0 !important; border-radius: 0 !important; box-shadow: none !important; outline: 0;
    background: transparent !important; color: var(--fps-ink) !important;
    text-align: center; font-weight: 700; font-size: 16px; line-height: 48px;
    -webkit-appearance: none; -moz-appearance: textfield; appearance: textfield;
  }
  #fps-{{ sid }} .fps__qty input::-webkit-inner-spin-button,
  #fps-{{ sid }} .fps__qty input::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
  #fps-{{ sid }} .fps__add {
    flex: 1 1 auto; min-width: 0; min-height: 52px;
    padding: 0 16px;
    background: var(--fps-yellow);
    color: var(--fps-ink);
    border: var(--fps-border);
    border-radius: 999px;
    box-shadow: var(--fps-shadow);
    font-weight: 800; font-size: 16px;
    cursor: pointer;
    transition: transform 120ms ease-out, box-shadow 120ms ease-out;
  }
  #fps-{{ sid }} .fps__add:hover { transform: translate(-1px,-1px); box-shadow: 5px 5px 0 var(--fps-ink); }
  #fps-{{ sid }} .fps__add:active { transform: translate(4px,4px); box-shadow: 0 0 0 var(--fps-ink); }
  #fps-{{ sid }} .fps__add[disabled] { opacity: .5; cursor: not-allowed; transform: none; }

  #fps-{{ sid }} .fps__desc { font-size: 14px; line-height: 1.55; }
  #fps-{{ sid }} .fps__desc p { margin: 0 0 10px; }

  #fps-{{ sid }} .fps__acc {
    border: 2px solid var(--fps-ink);
    border-radius: 10px;
    box-shadow: var(--fps-shadow-sm);
    background: #fff;
  }
  #fps-{{ sid }} .fps__acc + .fps__acc { margin-top: 12px; }
  #fps-{{ sid }} .fps__acc summary {
    list-style: none;
    display: flex; justify-content: space-between; align-items: center;
    padding: 14px 16px;
    font-weight: 800; font-size: 14px; text-transform: uppercase;
    cursor: pointer;
  }
  #fps-{{ sid }} .fps__acc summary::-webkit-details-marker { display: none; }
  #fps-{{ sid }} .fps__acc summary::after {
    content: ""; flex: 0 0 auto;
    width: 7px; height: 7px; margin-left: 12px;
    border-right: 2px solid currentColor; border-bottom: 2px solid currentColor;
    transform: rotate(45deg) translateY(-2px);
    transition: transform 200ms ease-out;
  }
  #fps-{{ sid }} .fps__acc[open] summary::after { transform: rotate(-135deg); }
  #fps-{{ sid }} .fps__acc-body { padding: 0 16px 16px; font-size: 14px; line-height: 1.55; }
  #fps-{{ sid }} .fps__acc-body img { max-width: 100%; height: auto; display: block; margin-top: 8px; }

  /* Tablet: columnas un poco más juntas */
  @media (max-width: 989px) {
    #fps-{{ sid }} .fps__inner { gap: 32px; padding: 0 24px; }
  }

  /* Teléfono: todo en una columna, imagen compacta y centrada */
  @media (max-width: 749px) {
    #fps-{{ sid }} { padding: {{ s.padding_y_mobile }}px 0; }
    #fps-{{ sid }} .fps__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
      padding: 0 16px;
    }
    #fps-{{ sid }} .fps__gallery {
      position: static;
      max-width: none;
      justify-self: stretch;
      margin: 0 -16px; /* el carrusel llega al borde y deja asomar la siguiente foto */
    }
    #fps-{{ sid }} .fps__track {
      padding: 0 16px 6px;
      scroll-padding-left: 16px;
      gap: 10px;
    }
    #fps-{{ sid }} .fps__slide {
      flex-basis: {{ s.slide_width_mobile }}%;
      border-radius: 12px;
      box-shadow: 3px 3px 0 var(--fps-ink);
    }
    #fps-{{ sid }} .fps__thumbs { display: none; }
    #fps-{{ sid }} .fps__nav { display: flex; }
    #fps-{{ sid }} .fps__info > * + * { margin-top: 14px; }
    #fps-{{ sid }} .fps__title { font-size: clamp(26px, 8vw, 34px); }
    #fps-{{ sid }} .fps__price { font-size: 26px; }
    #fps-{{ sid }} .fps__qty button { width: 34px; }
    #fps-{{ sid }} .fps__qty input { width: 28px !important; }
    #fps-{{ sid }} .fps__add { font-size: 15px; }
    #fps-{{ sid }} .fps__desc,
    #fps-{{ sid }} .fps__acc-body { font-size: 14px; }
    #fps-{{ sid }} .fps__acc summary { padding: 12px 14px; font-size: 13px; }
  }
</style>

<section id="fps-{{ sid }}" class="fps">
  {%- if product == blank -%}
    <div class="fps__inner"><p>Elige un producto en la configuración de esta sección.</p></div>
  {%- else -%}
  <div class="fps__inner">

    <div class="fps__gallery">
      <div class="fps__track" aria-label="Imágenes del producto">
        {%- for media in product.media -%}
          <div class="fps__slide" data-index="{{ forloop.index0 }}">
            {%- if forloop.first -%}{%- assign img_loading = 'eager' -%}{%- else -%}{%- assign img_loading = 'lazy' -%}{%- endif -%}
            {{ media.preview_image | image_url: width: 1200 | image_tag:
              loading: img_loading,
              sizes: '(max-width: 749px) 85vw, 440px',
              widths: '300, 440, 600, 880, 1200',
              alt: media.alt | default: product.title
            }}
          </div>
        {%- else -%}
          <div class="fps__slide">{{ 'product-1' | placeholder_svg_tag }}</div>
        {%- endfor -%}
      </div>

      {%- if product.media.size > 1 -%}
        <div class="fps__nav">
          <button type="button" class="fps__arrow fps__arrow--prev" aria-label="Imagen anterior"></button>
          <span class="fps__count"><span data-fps-current>1</span>/{{ product.media.size }}</span>
          <button type="button" class="fps__arrow fps__arrow--next" aria-label="Imagen siguiente"></button>
        </div>

        <div class="fps__thumbs">
          {%- for media in product.media -%}
            <button type="button" class="fps__thumb" data-index="{{ forloop.index0 }}"
              aria-label="Ver imagen {{ forloop.index }}"
              {% if forloop.first %}aria-current="true"{% endif %}>
              {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- form 'product', product, id: form_id, class: 'fps__info', data-type: 'add-to-cart-form' -%}
      <input type="hidden" name="id" value="{{ variant.id }}" data-fps-id>

      {%- for block in section.blocks -%}
        {%- case block.type -%}

          {%- when '@app' -%}
            <div class="fps__app">{% render block %}</div>

          {%- when 'subscription' -%}
            {%- comment -%}
              Réplica del widget de la app Suscripciones Fuly Kids. El bloque de la app solo
              carga en plantillas de producto; aquí se le pasan los mismos datos a mano.
            {%- endcomment -%}
            <div class="fps__subs" {{ block.shopify_attributes }}>
              <div id="subscription-widget-container"
                data-product-id="{{ product.id }}"
                data-shop="{{ shop.permanent_domain }}"
                data-variant-id="{{ variant.id }}"
                data-price="{{ variant.price | divided_by: 100.0 }}"
                data-app-url="https://suscripciones-moxie-1.onrender.com/"
                data-show-always="{{ block.settings.show_always }}"></div>
              <script src="https://suscripciones-moxie-1.onrender.com/api/extension-asset/subscription-widget.js" defer></script>
            </div>

          {%- when 'badge' -%}
            {%- if block.settings.text != blank -%}
              <div {{ block.shopify_attributes }}><span class="fps__badge">{{ block.settings.text }}</span></div>
            {%- endif -%}

          {%- when 'title' -%}
            <h2 class="fps__title" {{ block.shopify_attributes }}>{{ block.settings.text | default: product.title }}</h2>

          {%- when 'rating' -%}
            <div class="fps__rating" {{ block.shopify_attributes }} aria-label="{{ reviews_count }} reseñas">
              <span class="fps__stars" aria-hidden="true">★★★★★</span>
              <span class="fps__rating-count">({{ reviews_count }} reseñas)</span>
            </div>

          {%- when 'price' -%}
            <div class="fps__price" {{ block.shopify_attributes }} data-fps-price>
              {{ variant.price | money_without_trailing_zeros }}
              {%- if variant.compare_at_price > variant.price -%}
                <s>{{ variant.compare_at_price | money_without_trailing_zeros }}</s>
              {%- endif -%}
            </div>

          {%- when 'variant_picker' -%}
            {%- unless product.has_only_default_variant -%}
              <div class="fps__variant" {{ block.shopify_attributes }}>
                <select aria-label="{{ product.options.first | escape }}">
                  {%- for v in product.variants -%}
                    <option value="{{ v.id }}" data-price="{{ v.price | money_without_trailing_zeros }}"
                      {% if v.id == variant.id %}selected{% endif %}
                      {% unless v.available %}disabled{% endunless %}>
                      {{ v.title }}{% unless v.available %} · Agotado{% endunless %}
                    </option>
                  {%- endfor -%}
                </select>
              </div>
            {%- endunless -%}

          {%- when 'buy' -%}
            <div class="fps__buy" {{ block.shopify_attributes }} data-fps-action="{{ block.settings.action }}">
              <div class="fps__qty">
                <button type="button" data-qty="-1" aria-label="Menos">−</button>
                <input type="number" name="quantity" value="1" min="1" aria-label="Cantidad">
                <button type="button" data-qty="1" aria-label="Más">+</button>
              </div>
              <button type="submit" name="add" class="fps__add" {% unless variant.available %}disabled{% endunless %}>
                {%- if variant.available -%}
                  {%- if block.settings.action == 'checkout' -%}{{ block.settings.label_checkout }}{%- else -%}{{ block.settings.label }}{%- endif -%}
                {%- else -%}Agotado{%- endif -%}
              </button>
            </div>

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="fps__desc" {{ block.shopify_attributes }}>{{ product.description }}</div>
            {%- endif -%}

          {%- when 'accordion' -%}
            <details class="fps__acc" {{ block.shopify_attributes }} {% if block.settings.open %}open{% endif %}>
              <summary>{{ block.settings.heading }}</summary>
              <div class="fps__acc-body">
                {{ block.settings.content }}
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy' }}
                {%- endif -%}
              </div>
            </details>

        {%- endcase -%}
      {%- endfor -%}
    {%- endform -%}

  </div>
  {%- endif -%}
</section>

<script>
  (function () {
    var root = document.getElementById('fps-{{ sid }}');
    if (!root) return;

    // Carrusel
    var track = root.querySelector('.fps__track');
    var slides = root.querySelectorAll('.fps__slide');
    var thumbs = root.querySelectorAll('.fps__thumb');
    var current = root.querySelector('[data-fps-current]');
    var prev = root.querySelector('.fps__arrow--prev');
    var next = root.querySelector('.fps__arrow--next');
    var active = 0;

    function goTo(i) {
      i = Math.max(0, Math.min(slides.length - 1, i));
      var gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      track.scrollTo({ left: i * (slides[0].offsetWidth + gap), behavior: 'smooth' });
    }
    function setActive(i) {
      active = i;
      if (current) current.textContent = i + 1;
      if (prev) prev.disabled = i === 0;
      if (next) next.disabled = i === slides.length - 1;
      thumbs.forEach(function (t, n) {
        if (n === i) t.setAttribute('aria-current', 'true'); else t.removeAttribute('aria-current');
      });
    }

    if (track && slides.length > 1) {
      // Detecta qué foto está a la vista mientras se desliza
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting && en.intersectionRatio >= 0.6) setActive(parseInt(en.target.dataset.index, 10));
          });
        }, { root: track, threshold: [0.6] });
        slides.forEach(function (sl) { io.observe(sl); });
      }
      thumbs.forEach(function (t) {
        t.addEventListener('click', function () { goTo(parseInt(t.dataset.index, 10)); });
      });
      if (prev) prev.addEventListener('click', function () { goTo(active - 1); });
      if (next) next.addEventListener('click', function () { goTo(active + 1); });
      setActive(0);
    }

    var qty = root.querySelector('.fps__qty input');
    root.querySelectorAll('[data-qty]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        qty.value = Math.max(1, (parseInt(qty.value, 10) || 1) + parseInt(btn.dataset.qty, 10));
        qty.dispatchEvent(new Event('change', { bubbles: true }));
      });
    });

    // "Comprar ahora": agrega al carrito por AJAX y manda directo al checkout,
    // sin pasar por el carrito lateral. Incluye el plan de suscripción si se eligió.
    var buy = root.querySelector('[data-fps-action="checkout"]');
    var form = root.querySelector('form.fps__info');
    if (buy && form) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        e.stopImmediatePropagation();
        var btn = form.querySelector('.fps__add');
        if (btn) { btn.disabled = true; btn.dataset.label = btn.textContent; btn.textContent = 'Un momento…'; }
        var data = new FormData(form);
        // Propiedades de suscripción (tipo de compra, frecuencia, descuento) del widget de la app
        if (typeof window.__subsWidgetGetCurrentProperties === 'function') {
          var props = window.__subsWidgetGetCurrentProperties() || {};
          Object.keys(props).forEach(function (k) { data.set('properties[' + k + ']', props[k]); });
        }
        fetch(window.Shopify && Shopify.routes ? Shopify.routes.root + 'cart/add.js' : '/cart/add.js', {
          method: 'POST',
          headers: { 'Accept': 'application/json' },
          body: data
        })
          .then(function (r) { if (!r.ok) throw r; window.location.href = '/checkout'; })
          .catch(function () {
            if (btn) { btn.disabled = false; btn.textContent = btn.dataset.label; }
            alert('No pudimos agregar el producto. Intenta de nuevo.');
          });
      }, true);
    }

    var select = root.querySelector('.fps__variant select');
    var price = root.querySelector('[data-fps-price]');
    var idInput = root.querySelector('[data-fps-id]');
    if (select) {
      select.addEventListener('change', function () {
        var opt = select.options[select.selectedIndex];
        if (idInput) {
          idInput.value = opt.value;
          idInput.dispatchEvent(new Event('change', { bubbles: true }));
        }
        if (price) price.textContent = opt.dataset.price;
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Fuly · Producto sticky",
  "tag": "div",
  "class": "section-fuly-producto-sticky",
  "settings": [
    { "type": "product", "id": "product", "label": "Producto" },
    { "type": "header", "content": "Diseño" },
    { "type": "color", "id": "bg_color", "label": "Fondo", "default": "#FFFFFF" },
    { "type": "range", "id": "sticky_offset", "label": "Separación de la imagen fija con el borde superior", "info": "Súbelo si el header tapa la imagen al hacer scroll.", "min": 0, "max": 200, "step": 10, "unit": "px", "default": 110 },
