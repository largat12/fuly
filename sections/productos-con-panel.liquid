{%- comment -%}
  Sección: Productos + Panel (imagen / texto)
  ------------------------------------------------------------------
  Reutiliza las clases del design system de Fuly (.fuly-product-card,
  .fuly-tag-label, .fuly-lab-grid-bg, .fuly-animate-float) para heredar
  la grilla, el tinte, el flotado, el hover y el botón AJAX del carrito.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign product_blocks = section.blocks | where: 'type', 'product'
  assign item_blocks = section.blocks | where: 'type', 'item'

  assign mf_path = s.benefit_metafield | strip
  assign mf_parts = mf_path | split: '.'

  # ---- Proporción del panel: se convierte a % para forzar la altura ----
  assign ratio_str = s.panel_image_ratio
  if ratio_str == 'custom'
    assign ratio_str = s.panel_image_ratio_custom
  endif
  assign ratio_str = ratio_str | replace: ' ', '' | replace: ':', '/'
  assign rp = ratio_str | split: '/'
  assign rw = rp[0] | plus: 0.0
  assign rh = rp[1] | plus: 0.0
  if rw <= 0 or rh <= 0
    assign rw = 1.0
    assign rh = 1.0
  endif
  assign ratio_pct = rh | times: 100.0 | divided_by: rw | round: 3

  # ---- Layout de escritorio ----
  assign prod_justify = 'start'
  if s.products_align == 'center'
    assign prod_justify = 'center'
  endif

  # El panel solo se parte en dos columnas si hay imagen "arriba del texto"
  assign split_panel = false
  if s.desktop_layout == 'stacked' and s.panel_image != blank and s.image_style == 'top'
    assign split_panel = true
  endif

  # Alineación vertical del contenido del panel en escritorio apilado
  assign content_justify = 'center'
  if s.panel_content_valign == 'top'
    assign content_justify = 'flex-start'
  elsif s.panel_content_valign == 'between'
    assign content_justify = 'space-between'
  endif
-%}

<style>
  #shopify-section-{{ section.id }} {
    --fk-gap: {{ s.gap }}px;
    --fk-cols: {{ s.columns }};
    --fk-card-img-h: {{ s.card_image_height }}px;
  }

  #shopify-section-{{ section.id }} .fk-pi {
    padding: {{ s.padding_top }}px 0 {{ s.padding_bottom }}px;
    {%- if s.bg_color != blank and s.bg_color != 'rgba(0,0,0,0)' %}
    background-color: {{ s.bg_color }};
    {%- endif %}
  }
  #shopify-section-{{ section.id }} .fk-pi__inner {
    max-width: {{ s.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  #shopify-section-{{ section.id }} .fk-pi__head { margin: 0 0 24px; max-width: 72rem; }
  #shopify-section-{{ section.id }} .fk-pi__title {
    font-family: var(--fuly-font-heading);
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(26px, 4vw, 44px);
    line-height: 1.05;
    color: hsl(var(--cartoon-black));
    margin: 0 0 8px;
  }
  #shopify-section-{{ section.id }} .fk-pi__sub {
    font-family: var(--fuly-font-body);
    font-size: 16px;
    line-height: 1.5;
    color: hsl(var(--cartoon-black) / .75);
  }
  #shopify-section-{{ section.id }} .fk-pi__sub p { margin: 0 0 6px; }

  /* ---------- Layout 2 columnas ---------- */
  #shopify-section-{{ section.id }} .fk-pi__grid {
    display: grid;
    grid-template-columns: minmax(0, {{ s.products_ratio }}fr) minmax(0, 1fr);
    gap: var(--fk-gap);
    align-items: start;
  }
  #shopify-section-{{ section.id }} .fk-pi__grid--reverse .fk-pi__products { order: 2; }
  #shopify-section-{{ section.id }} .fk-pi__grid--reverse .fk-panel { order: 1; }

  /* Grilla de productos: hereda .fuly-products-grid y solo sobreescribe columnas */
  #shopify-section-{{ section.id }} .fuly-products-grid {
    grid-template-columns: repeat(var(--fk-cols), minmax(0, 1fr));
    gap: var(--fk-gap);
  }
  #shopify-section-{{ section.id }} .fuly-product-card__image-wrap { height: var(--fk-card-img-h); }

  /* ---------- Panel (mismos tokens del tema) ---------- */
  #shopify-section-{{ section.id }} .fk-panel {
    position: relative;
    background-color: {{ s.panel_bg }};
    color: hsl(var(--cartoon-black));
    border: 2px solid hsl(var(--cartoon-black));
    box-shadow: 4px 4px hsl(var(--cartoon-black));
    border-radius: 1.6rem;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  {%- if s.sticky_panel %}
  @media (min-width: 990px) {
    #shopify-section-{{ section.id }} .fk-panel { position: sticky; top: 24px; }
  }
  {%- endif %}
  /* La proporción se fuerza con padding-top en el contenedor y la imagen se
     posiciona en absoluto: así ningún "height:auto" del tema puede anularla. */
  #shopify-section-{{ section.id }} .fk-panel__img {
    display: block;
    position: relative;
    width: 100%;
    overflow: hidden;
    {%- if s.panel_image_ratio != 'original' %}
    height: 0;
    padding-top: {{ ratio_pct }}%;
    {%- endif %}
  }
  #shopify-section-{{ section.id }} .fk-panel__img img,
  #shopify-section-{{ section.id }} .fk-panel__img svg {
    display: block;
    {%- if s.panel_image_ratio == 'original' %}
    position: relative;
    width: 100%;
    height: auto;
    {%- else %}
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    {%- endif %}
    object-fit: {{ s.panel_image_fit }};
    object-position: {{ s.panel_image_position }};
  }
  #shopify-section-{{ section.id }} .fk-panel__grid-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: linear-gradient(rgba(0,0,0,.06) 1px, transparent 1px), linear-gradient(90deg, rgba(0,0,0,.06) 1px, transparent 1px);
    background-size: 20px 20px;
  }
  #shopify-section-{{ section.id }} .fk-panel--overlay .fk-panel__img {
    position: absolute;
    inset: 0;
    z-index: 0;
    height: auto;
    padding-top: 0;
  }
  #shopify-section-{{ section.id }} .fk-panel--overlay .fk-panel__img img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  #shopify-section-{{ section.id }} .fk-panel--overlay::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background-color: {{ s.panel_bg }};
    opacity: {{ s.overlay_opacity | divided_by: 100.0 }};
  }
  #shopify-section-{{ section.id }} .fk-panel__content {
    position: relative;
    z-index: 2;
    padding: clamp(1.6rem, 2.4vw, 2.4rem);
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    flex: 1 1 auto;
  }
  #shopify-section-{{ section.id }} .fk-panel__title {
    font-family: var(--fuly-font-heading);
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(18px, 2.2vw, 26px);
    line-height: 1.1;
    margin: 0;
  }
  #shopify-section-{{ section.id }} .fk-panel__text {
    font-family: var(--fuly-font-body);
    font-size: 15px;
    line-height: 1.5;
    margin: 0;
  }
  #shopify-section-{{ section.id }} .fk-panel__text p { margin: 0 0 8px; }
  #shopify-section-{{ section.id }} .fk-panel__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  #shopify-section-{{ section.id }} .fk-panel__list li {
    display: grid;
    grid-template-columns: 2.2rem 1fr;
    gap: 1rem;
    align-items: start;
    font-family: var(--fuly-font-body);
    font-size: 14px;
    line-height: 1.35;
  }
  #shopify-section-{{ section.id }} .fk-panel__check {
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    border: 2px solid hsl(var(--cartoon-black));
    border-radius: 5px;
    font-size: 12px;
    font-weight: 700;
    margin-top: 1px;
  }
  #shopify-section-{{ section.id }} .fk-panel__cta {
    margin-top: auto;
    width: 100%;
    box-sizing: border-box;
    {%- if s.panel_btn_style == 'theme' %}
    /* Mismo botón que el resto del sitio: amarillo, borde negro, píldora */
    background-color: var(--yellow-spark);
    color: hsl(var(--cartoon-black));
    border-radius: 999px;
    {%- else %}
    background-color: {{ s.panel_btn_bg }};
    color: {{ s.panel_btn_text }};
    border-radius: {{ s.panel_btn_radius }}px;
    {%- endif %}
    border: 2px solid hsl(var(--cartoon-black));
    box-shadow: 3px 3px hsl(var(--cartoon-black));
    font-family: "Arial Black", Arial, sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 14px;
    padding: 1.4rem 2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    cursor: pointer;
    transition: transform .2s, box-shadow .2s;
  }
  #shopify-section-{{ section.id }} .fk-panel__cta:hover {
    transform: translate(1px, 1px);
    box-shadow: 2px 2px hsl(var(--cartoon-black));
  }

{%- if s.desktop_layout == 'stacked' %}
  /* ---------- Escritorio apilado: productos arriba, panel abajo ----------
     Evita la franja blanca que queda cuando el panel es más alto que las
     tarjetas: nada queda al costado de un bloque alto. */
  @media (min-width: 990px) {
    #shopify-section-{{ section.id }} .fk-pi__grid { grid-template-columns: minmax(0, 1fr); }
    #shopify-section-{{ section.id }} .fuly-products-grid {
    {%- if s.cards_fill %}
      /* Las tarjetas se reparten todo el ancho disponible */
      grid-template-columns: repeat(var(--fk-cols), minmax(0, 1fr));
    {%- else %}
      grid-template-columns: repeat(var(--fk-cols), minmax(0, {{ s.cards_max_width }}px));
      justify-content: {{ prod_justify }};
    {%- endif %}
    }
  {%- if split_panel %}
    #shopify-section-{{ section.id }} .fk-panel {
      display: grid;
      grid-template-columns: {{ s.panel_split }};
      align-items: stretch;
    }
    #shopify-section-{{ section.id }} .fk-panel__img {
      height: auto;
      padding-top: 0;
      {%- if s.panel_image_side == 'right' %}
      order: 2;
      {%- endif %}
      {%- if s.panel_image_desktop_fit == 'whole' %}
      /* La imagen manda su propio alto: se ve completa, nunca se recorta */
      align-self: center;
      {%- else %}
      min-height: {{ s.panel_image_min_height }}px;
      {%- endif %}
    }
    #shopify-section-{{ section.id }} .fk-panel__img img {
      {%- if s.panel_image_desktop_fit == 'whole' %}
      position: relative;
      inset: auto;
      width: 100%;
      height: auto;
      max-width: 100%;
      object-fit: contain;
      {%- else %}
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      max-width: none;
      {%- endif %}
    }
    /* Reparto vertical del texto; sin esto el botón se va al fondo */
    #shopify-section-{{ section.id }} .fk-panel__content {
      justify-content: {{ content_justify }};
    }
    {%- if s.panel_content_valign != 'between' %}
    #shopify-section-{{ section.id }} .fk-panel__cta { margin-top: 0; }
    {%- endif %}
  {%- endif %}
  }
{%- endif %}

  /* ---------- Responsive ---------- */
  @media (max-width: 989px) {
    #shopify-section-{{ section.id }} .fk-pi__grid { grid-template-columns: minmax(0, 1fr); }
    #shopify-section-{{ section.id }} .fk-pi__grid--reverse .fk-pi__products,
    #shopify-section-{{ section.id }} .fk-pi__grid--reverse .fk-panel { order: initial; }
    #shopify-section-{{ section.id }} { --fk-cols: 2; }
  }
  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} {
      --fk-gap: {{ s.gap_mobile }}px;
      --fk-card-img-h: {{ s.card_image_height_mobile }}px;
    }
    #shopify-section-{{ section.id }} .fk-pi {
      padding: {{ s.padding_top | times: 0.65 | round }}px 0 {{ s.padding_bottom | times: 0.65 | round }}px;
    }
    #shopify-section-{{ section.id }} .fk-pi__inner { padding: 0 16px; }
    #shopify-section-{{ section.id }} .fk-pi__head { margin-bottom: 18px; }
{%- if s.mobile_layout == 'carousel' %}
    #shopify-section-{{ section.id }} .fuly-products-grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      margin: 0 -16px;
      padding: 4px 16px 12px;
    }
    #shopify-section-{{ section.id }} .fuly-products-grid::-webkit-scrollbar { display: none; }
    #shopify-section-{{ section.id }} .fuly-products-grid > * { flex: 0 0 74%; max-width: 300px; scroll-snap-align: start; }
{%- elsif s.mobile_layout == 'one' %}
    #shopify-section-{{ section.id }} { --fk-cols: 1; }
{%- else %}
    #shopify-section-{{ section.id }} { --fk-cols: 2; }
{%- endif %}
  }
</style>

<div class="fk-pi{% if s.show_grid_bg %} fuly-lab-grid-bg{% endif %}">
  <div class="fk-pi__inner">

    {%- if s.heading != blank or s.subheading != blank -%}
      <header class="fk-pi__head">
        {%- if s.heading != blank -%}
          <h2 class="fk-pi__title">{{ s.heading }}</h2>
        {%- endif -%}
        {%- if s.subheading != blank -%}
          <div class="fk-pi__sub">{{ s.subheading }}</div>
        {%- endif -%}
      </header>
    {%- endif -%}

    <div class="fk-pi__grid{% if s.desktop_layout == 'stacked' %} fk-pi__grid--stacked{% elsif s.panel_position == 'left' %} fk-pi__grid--reverse{% endif %}">

      {%- comment -%} ---------- COLUMNA DE PRODUCTOS ---------- {%- endcomment -%}
      <div class="fk-pi__products">
        <div class="fuly-products-grid">
          {%- for block in product_blocks -%}
            {%- assign card_product = block.settings.product -%}

            {%- liquid
                # Línea descriptiva: texto del bloque > metafield / metaobject > nada
                assign benefit = block.settings.caption
                if benefit == blank and mf_parts.size >= 2 and card_product != blank
                  assign ns = mf_parts[0]
                  assign key = mf_parts[1]
                  assign mf = card_product.metafields[ns][key]
                  if mf_parts.size > 2
                    assign sub = mf_parts[2]
                    assign benefit = mf.value[sub]
                  else
                    assign benefit = mf.value
                  endif
                endif

                assign card_variant = card_product.selected_or_first_available_variant
              -%}

              <article class="fuly-product-card" {{ block.shopify_attributes }}>

                <a
                  href="{{ card_product.url | default: '#' }}"
                  class="fuly-product-card__image-wrap"
                  {%- if block.settings.tint != blank and block.settings.tint != 'rgba(0,0,0,0)' %} style="--card-tint-from: {{ block.settings.tint }}22; --card-tint-to: {{ block.settings.tint }}44;"{% endif %}
                >
                  <span class="fuly-product-card__grid-overlay" aria-hidden="true"></span>

                  {%- assign card_image = block.settings.image | default: card_product.featured_image -%}
                  {%- if card_image != blank -%}
                    <img
                      src="{{ card_image | image_url: width: 600 }}"
                      alt="{{ card_product.title | escape }}"
                      class="fuly-product-card__image{% if s.float_animation %} fuly-animate-float{% endif %}{% if block.settings.image_scale != 'none' %} fuly-product-card__image--{{ block.settings.image_scale }}{% endif %}"
                      loading="lazy"
                      width="200"
                      height="200"
                    >
                  {%- else -%}
                    {{ 'product-apparel-1' | placeholder_svg_tag: 'fuly-product-card__image' }}
                  {%- endif -%}

                  {%- if block.settings.badge != blank -%}
                    <span class="fuly-product-card__tag">
                      <span class="fuly-tag-label">{{ block.settings.badge }}</span>
                    </span>
                  {%- endif -%}
                </a>

                <div class="fuly-product-card__body">
                  <a href="{{ card_product.url | default: '#' }}" style="text-decoration:none;color:inherit;">
                    <h3 class="fuly-product-card__title">
                      {{ block.settings.title | default: card_product.title | default: 'Producto de ejemplo' }}
                    </h3>
                  </a>

                  {%- if benefit != blank -%}
                    <p class="fuly-product-card__benefit">{{ benefit }}</p>
                  {%- endif -%}

                  <div class="fuly-product-card__footer">
                    {%- if s.show_price -%}
                      <span class="fuly-product-card__price-group">
                        {%- if card_product.compare_at_price > card_product.price -%}
                          <span class="fuly-product-card__price--compare">{{ card_product.compare_at_price | money }}</span>
                        {%- endif -%}
                        <span class="fuly-product-card__price">
                          {%- if card_product != blank -%}{{ card_product.price | money }}{%- else -%}{{ 11490000 | money }}{%- endif -%}
                        </span>
                      </span>
                    {%- endif -%}

                    {%- if card_product == blank -%}
                      <span class="fuly-product-card__btn">
                        <span class="fuly-product-card__btn-text-wide">{{ s.add_label }}</span>
                      </span>

                    {%- elsif s.button_action == 'link' -%}
                      <a class="fuly-product-card__btn" href="{{ card_product.url }}">
                        <span class="fuly-product-card__btn-text-wide">{{ s.view_label }}</span>
                        <span class="fuly-product-card__btn-text-narrow">+</span>
                      </a>

                    {%- else -%}
                      <button
                        type="button"
                        class="fuly-product-card__btn"
                        data-fuly-add-to-cart
                        data-variant-id="{{ card_variant.id }}"
                        data-product-url="{{ card_product.url }}"
                        aria-label="Agregar {{ card_product.title | escape }} al carrito"
                        {%- unless card_variant.available %} disabled{% endunless %}
                      >
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <circle cx="9" cy="21" r="1"></circle>
                          <circle cx="20" cy="21" r="1"></circle>
                          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                        </svg>
                        <span class="fuly-product-card__btn-text-wide">
                          {%- if card_variant.available -%}{{ s.add_label }}{%- else -%}{{ s.soldout_label }}{%- endif -%}
                        </span>
                        <span class="fuly-product-card__btn-text-narrow">+</span>
                      </button>
                    {%- endif -%}
                  </div>
                </div>

            </article>

          {%- else -%}
            <article class="fuly-product-card">
              <span class="fuly-product-card__image-wrap">
                <span class="fuly-product-card__grid-overlay" aria-hidden="true"></span>
                {{ 'product-apparel-2' | placeholder_svg_tag: 'fuly-product-card__image' }}
              </span>
              <div class="fuly-product-card__body">
                <h3 class="fuly-product-card__title">Agrega un bloque de producto</h3>
                <p class="fuly-product-card__benefit">Personalizar &rarr; Agregar bloque &rarr; Producto</p>
              </div>
            </article>
          {%- endfor -%}
        </div>
      </div>

      {%- comment -%} ---------- PANEL IMAGEN + TEXTO ---------- {%- endcomment -%}
      <aside class="fk-panel{% if s.image_style == 'background' and s.panel_image != blank %} fk-panel--overlay{% endif %}">

        {%- if s.panel_image != blank and s.image_style != 'none' -%}
          <div class="fk-panel__img">
            {{ s.panel_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400,600,800,1200', alt: s.panel_title }}
            {%- if s.panel_grid_overlay -%}
              <span class="fk-panel__grid-overlay" aria-hidden="true"></span>
            {%- endif -%}
          </div>
        {%- endif -%}

        <div class="fk-panel__content">
          {%- if s.panel_title != blank -%}
            <h3 class="fk-panel__title">{{ s.panel_title }}</h3>
          {%- endif -%}

          {%- if s.panel_text != blank -%}
            <div class="fk-panel__text">{{ s.panel_text }}</div>
          {%- endif -%}

          {%- if item_blocks.size > 0 -%}
            <ul class="fk-panel__list">
              {%- for block in item_blocks -%}
                <li {{ block.shopify_attributes }}>
                  <span class="fk-panel__check" aria-hidden="true">{{ block.settings.icon | default: '&#10003;' }}</span>
                  <span>{{ block.settings.text }}</span>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- if s.panel_btn_label != blank -%}
            <a class="fk-panel__cta" href="{{ s.panel_btn_link | default: '#' }}">{{ s.panel_btn_label }}</a>
          {%- endif -%}
        </div>

      </aside>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Productos + Panel",
  "tag": "div",
  "class": "fk-section-productos-panel",
  "max_blocks": 20,
  "settings": [
    { "type": "header", "content": "Encabezado" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Elige tu malteada" },
    { "type": "richtext", "id": "subheading", "label": "Descripción", "default": "<p>Las dos tienen la misma fórmula: proteína de almendra y huevo, 18 vitaminas y minerales, cero azúcar añadida.</p>" },

    { "type": "header", "content": "Distribución" },
    {
      "type": "select",
      "id": "desktop_layout",
      "label": "Diseño en escritorio",
      "default": "stacked",
      "info": "\"Apilado\" evita la franja blanca que queda al costado cuando el panel es más alto que las tarjetas.",
      "options": [
        { "value": "stacked", "label": "Apilado: productos arriba, panel abajo" },
        { "value": "side", "label": "En paralelo: productos y panel lado a lado" }
      ]
    },
    { "type": "checkbox", "id": "cards_fill", "label": "Tarjetas a todo el ancho (apilado)", "default": false, "info": "Reparten todo el ancho de la sección, sin espacio sobrante. Al activarlo se ignoran el ancho máximo y la alineación de abajo." },
    { "type": "range", "id": "cards_max_width", "label": "Ancho máximo de cada tarjeta (apilado)", "min": 240, "max": 720, "step": 20, "unit": "px", "default": 340 },
    {
      "type": "select",
      "id": "products_align",
      "label": "Alineación de las tarjetas (apilado)",
      "default": "left",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" }
      ]
    },
    {
      "type": "select",
      "id": "panel_position",
      "label": "Posición del panel (solo en paralelo)",
