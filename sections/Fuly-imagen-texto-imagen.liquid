{%- comment -%}
  FULY · Sección "Dos imágenes + pie"
  Guardar como: sections/fuly-dos-imagenes.liquid

  Estructura:
    Título (ancho completo)
    [ Imagen A ]  [ Imagen B ]
    Pie: claim / texto / botón (ancho configurable)

  Mobile-first: se apila y tiene sus propios controles de tamaño y espaciado.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
-%}

{% style %}
  .fuly-two{
    background: {{ s.bg_color }};
    padding-top: {{ s.padding_top_mobile }}px;
    padding-bottom: {{ s.padding_bottom_mobile }}px;
  }
  {% if s.lab_grid %}
  .fuly-two{
    background-image:
      repeating-linear-gradient(0deg, rgba(0,0,0,.055) 0 1px, transparent 1px 32px),
      repeating-linear-gradient(90deg, rgba(0,0,0,.055) 0 1px, transparent 1px 32px);
  }
  {% endif %}

  .fuly-two__inner{
    max-width: {{ s.max_width }}px;
    margin-inline: auto;
    padding-inline: {{ s.padding_inline_mobile }}px;
    display: grid;
    grid-template-columns: 1fr;
    column-gap: {{ s.column_gap_mobile }}px;
    row-gap: {{ s.row_gap_mobile }}px;
  }

  .fuly-two__head{ margin: 0; }
  .fuly-two__heading{
    margin: 0;
    font-size: {{ s.heading_size_mobile }}px;
    line-height: 1.02;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    color: {{ s.heading_color }};
    {% if s.heading_toy_shadow %}text-shadow: 3px 3px 0 {{ s.heading_shadow_color }};{% endif %}
    text-align: {{ s.heading_align_mobile }};
  }

  .fuly-two__media{
    margin: 0;
    overflow: hidden;
    border-radius: {{ s.image_radius }}px;
    {% if s.image_border > 0 %}border: {{ s.image_border }}px solid #000;{% endif %}
    {% if s.image_shadow %}box-shadow: 4px 4px 0 #000;{% endif %}
    background: {{ s.image_bg }};
    line-height: 0;
  }
  .fuly-two__media img{ display: block; width: 100%; }
  {% if s.ratio_mobile != 'auto' %}
  .fuly-two__media{ aspect-ratio: {{ s.ratio_mobile }}; }
  .fuly-two__media img{ height: 100%; object-fit: {{ s.image_fit }}; }
  {% else %}
  .fuly-two__media img{ height: auto; }
  {% endif %}

  .fuly-two__foot{
    display: flex;
    flex-direction: column;
    gap: {{ s.foot_gap_mobile }}px;
    text-align: {{ s.foot_align_mobile }};
    align-items: {% if s.foot_align_mobile == 'center' %}center{% else %}flex-start{% endif %};
  }

  .fuly-two__text{ margin: 0; line-height: 1.5; }
  .fuly-two__text > *:first-child{ margin-top: 0; }
  .fuly-two__text > *:last-child{ margin-bottom: 0; }

  .fuly-two__descriptor{
    margin: 0;
    font-family: ui-monospace, "Martian Mono", SFMono-Regular, Menlo, monospace;
    text-transform: uppercase;
    letter-spacing: .08em;
    font-size: 12px;
    line-height: 1.4;
  }

  .fuly-two__claim{
    margin: 0;
    width: 100%;
    border: 3px solid #000;
    border-radius: 16px;
    padding: 14px 18px;
    font-family: ui-monospace, "Martian Mono", SFMono-Regular, Menlo, monospace;
    text-transform: uppercase;
    letter-spacing: .03em;
    font-weight: 700;
    font-size: 12px;
    line-height: 1.35;
    box-shadow: 4px 4px 0 #000;
  }

  .fuly-two__btn{
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    text-decoration: none;
    width: 100%;
    border: 3px solid #000;
    border-radius: 999px;
    padding: 15px 28px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .02em;
    line-height: 1.1;
    box-shadow: 4px 4px 0 #000;
    transition: transform 120ms cubic-bezier(0.34,1.56,0.64,1), box-shadow 120ms ease-out;
  }
  .fuly-two__btn:hover{ transform: translate(-2px,-2px); box-shadow: 6px 6px 0 #000; }
  .fuly-two__btn:active{ transform: translate(4px,4px); box-shadow: 0 0 0 #000; }
  .fuly-two__btn:focus-visible{ outline: 3px solid #000; outline-offset: 3px; }

  @media (prefers-reduced-motion: reduce){
    .fuly-two__btn{ transition: none; }
    .fuly-two__btn:hover{ transform: none; box-shadow: 4px 4px 0 #000; }
  }

  {% unless s.button_full_mobile %}
  @media screen and (max-width: 749px){
    .fuly-two__btn{ width: auto; }
  }
  {% endunless %}

  {% if s.mobile_first_image == 'b' %}
  @media screen and (max-width: 749px){
    .fuly-two__media--a{ order: 2; }
    .fuly-two__media--b{ order: 1; }
    .fuly-two__head{ order: 0; }
    .fuly-two__foot{ order: 3; }
  }
  {% endif %}

  @media screen and (min-width: 750px){
    .fuly-two{
      padding-top: {{ s.padding_top }}px;
      padding-bottom: {{ s.padding_bottom }}px;
    }
    .fuly-two__inner{
      padding-inline: {{ s.padding_inline }}px;
      grid-template-columns: {{ s.columns_ratio }};
      column-gap: {{ s.column_gap }}px;
      row-gap: {{ s.row_gap }}px;
      align-items: start;
    }
    .fuly-two__head{ grid-column: 1 / -1; }
    .fuly-two__heading{
      font-size: {{ s.heading_size }}px;
      text-align: {{ s.heading_align }};
    }
    {% if s.reverse %}
    .fuly-two__media--a{ grid-column: 2; grid-row: 2; }
    .fuly-two__media--b{ grid-column: 1; grid-row: 2; }
    {% endif %}
    {% if s.ratio != 'auto' %}
    .fuly-two__media{ aspect-ratio: {{ s.ratio }}; }
    .fuly-two__media img{ height: 100%; object-fit: {{ s.image_fit }}; }
    {% else %}
    .fuly-two__media{ aspect-ratio: auto; }
    .fuly-two__media img{ height: auto; }
    {% endif %}
    .fuly-two__foot{
      gap: {{ s.foot_gap }}px;
      text-align: {{ s.foot_align }};
      align-items: {% if s.foot_align == 'center' %}center{% elsif s.foot_align == 'right' %}flex-end{% else %}flex-start{% endif %};
      {% case s.foot_width %}
        {% when 'full' %}grid-column: 1 / -1;
        {% when 'left' %}grid-column: 1;
        {% when 'right' %}grid-column: 2;
      {% endcase %}
    }
    .fuly-two__descriptor,
    .fuly-two__claim{ font-size: 13px; }
    .fuly-two__btn{ width: auto; }
    {% if s.button_full_desktop %}
    .fuly-two__btn{ width: 100%; }
    {% endif %}
  }
{% endstyle %}

<section
  class="fuly-two"
  {% if s.anchor_id != blank %}id="{{ s.anchor_id | handle }}"{% endif %}
>
  <div class="fuly-two__inner">

    {%- if s.heading != blank -%}
      <div class="fuly-two__head">
        <h2 class="fuly-two__heading">{{ s.heading }}</h2>
      </div>
    {%- endif -%}

    {%- if s.image_a != blank -%}
      <figure class="fuly-two__media fuly-two__media--a">
        {%- if s.image_a_mobile != blank -%}
          <picture>
            <source media="(min-width: 750px)" srcset="{{ s.image_a | image_url: width: 1200 }}">
            {{ s.image_a_mobile | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '100vw', widths: '400,600,750,900', alt: s.image_a_mobile.alt }}
          </picture>
        {%- else -%}
          {{ s.image_a | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw', widths: '400,600,800,1000,1200', alt: s.image_a.alt }}
        {%- endif -%}
      </figure>
    {%- endif -%}

    {%- if s.image_b != blank -%}
      <figure class="fuly-two__media fuly-two__media--b">
        {%- if s.image_b_mobile != blank -%}
          <picture>
            <source media="(min-width: 750px)" srcset="{{ s.image_b | image_url: width: 1200 }}">
            {{ s.image_b_mobile | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '100vw', widths: '400,600,750,900', alt: s.image_b_mobile.alt }}
          </picture>
        {%- else -%}
          {{ s.image_b | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw', widths: '400,600,800,1000,1200', alt: s.image_b.alt }}
        {%- endif -%}
      </figure>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="fuly-two__foot">
        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- when 'claim' -%}
              <p
                class="fuly-two__claim"
                style="background:{{ block.settings.bg }};color:{{ block.settings.color }}"
                {{ block.shopify_attributes }}
              >{{ block.settings.text }}</p>

            {%- when 'text' -%}
              <div
                class="fuly-two__text"
                style="color:{{ block.settings.color }};font-size:{{ block.settings.size }}px"
                {{ block.shopify_attributes }}
              >{{ block.settings.text }}</div>

            {%- when 'descriptor' -%}
              <p
                class="fuly-two__descriptor"
                style="color:{{ block.settings.color }}"
                {{ block.shopify_attributes }}
              >{{ block.settings.text }}</p>

            {%- when 'button' -%}
              {%- if block.settings.label != blank -%}
                <a
                  class="fuly-two__btn"
                  href="{{ block.settings.link | default: '#' }}"
                  style="background:{{ block.settings.bg }};color:{{ block.settings.color }};font-size:{{ block.settings.size }}px"
                  {{ block.shopify_attributes }}
                >{{ block.settings.label }}</a>
              {%- endif -%}

          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Fuly · Dos imágenes",
  "tag": "section",
  "class": "fuly-two-section",
  "settings": [
    { "type": "header", "content": "Título" },
    { "type": "inline_richtext", "id": "heading", "label": "Título", "default": "No todas las malteadas son iguales" },
    { "type": "color", "id": "heading_color", "label": "Color", "default": "#000000" },
    { "type": "checkbox", "id": "heading_toy_shadow", "label": "Sombra sólida de juguete", "default": false },
    { "type": "color", "id": "heading_shadow_color", "label": "Color de la sombra", "default": "#FAE64B" },
    { "type": "range", "id": "heading_size", "label": "Tamaño (escritorio)", "min": 20, "max": 72, "step": 2, "unit": "px", "default": 42 },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Alineación (escritorio)",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" }
      ],
      "default": "left"
    },

    { "type": "header", "content": "Imágenes" },
    { "type": "image_picker", "id": "image_a", "label": "Imagen izquierda" },
    { "type": "image_picker", "id": "image_a_mobile", "label": "Imagen izquierda · versión móvil (opcional)" },
    { "type": "image_picker", "id": "image_b", "label": "Imagen derecha" },
    { "type": "image_picker", "id": "image_b_mobile", "label": "Imagen derecha · versión móvil (opcional)" },
    {
      "type": "select",
      "id": "ratio",
      "label": "Proporción en escritorio",
      "info": "Una proporción fija deja las dos imágenes de la misma altura.",
      "options": [
        { "value": "auto", "label": "Original de cada imagen" },
        { "value": "1 / 1", "label": "Cuadrada 1:1" },
        { "value": "4 / 5", "label": "Vertical 4:5" },
        { "value": "3 / 4", "label": "Vertical 3:4" },
        { "value": "4 / 3", "label": "Horizontal 4:3" },
        { "value": "16 / 9", "label": "Horizontal 16:9" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "select",
      "id": "ratio_mobile",
      "label": "Proporción en móvil",
      "options": [
        { "value": "auto", "label": "Original de cada imagen" },
        { "value": "1 / 1", "label": "Cuadrada 1:1" },
        { "value": "4 / 5", "label": "Vertical 4:5" },
        { "value": "4 / 3", "label": "Horizontal 4:3" }
      ],
      "default": "auto"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Al usar proporción fija",
      "options": [
        { "value": "cover", "label": "Recortar para llenar" },
        { "value": "contain", "label": "Mostrar completa" }
      ],
      "default": "cover"
    },
    { "type": "color_background", "id": "image_bg", "label": "Fondo detrás de la imagen", "default": "#FFFFFF" },
    { "type": "range", "id": "image_radius", "label": "Redondeo", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "image_border", "label": "Contorno negro", "min": 0, "max": 6, "step": 1, "unit": "px", "default": 3 },
    { "type": "checkbox", "id": "image_shadow", "label": "Sombra cartoon", "default": true },

    { "type": "header", "content": "Distribución (escritorio)" },
    {
      "type": "select",
      "id": "columns_ratio",
      "label": "Proporción de columnas",
      "options": [
        { "value": "1fr 1fr", "label": "50 / 50" },
        { "value": "1.2fr 1fr", "label": "55 / 45" },
        { "value": "1fr 1.2fr", "label": "45 / 55" }
      ],
      "default": "1fr 1fr"
    },
    { "type": "checkbox", "id": "reverse", "label": "Intercambiar izquierda y derecha", "default": false },
    { "type": "range", "id": "column_gap", "label": "Separación entre columnas", "min": 8, "max": 80, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "row_gap", "label": "Separación entre filas", "min": 8, "max": 80, "step": 4, "unit": "px", "default": 24 },

    { "type": "header", "content": "Pie (claim, texto, botón)" },
    {
      "type": "select",
      "id": "foot_width",
      "label": "Ancho del pie (escritorio)",
      "options": [
        { "value": "right", "label": "Solo bajo la columna derecha" },
        { "value": "left", "label": "Solo bajo la columna izquierda" },
        { "value": "full", "label": "Ancho completo" }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "foot_align",
      "label": "Alineación (escritorio)",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "left"
    },
    { "type": "range", "id": "foot_gap", "label": "Separación entre elementos", "min": 8, "max": 40, "step": 4, "unit": "px", "default": 16 },
    { "type": "checkbox", "id": "button_full_desktop", "label": "Botón de ancho completo en escritorio", "default": true },

    { "type": "header", "content": "Móvil" },
    {
      "type": "select",
      "id": "mobile_first_image",
      "label": "Mostrar primero",
      "options": [
        { "value": "a", "label": "Imagen izquierda" },
        { "value": "b", "label": "Imagen derecha" }
      ],
      "default": "a"
    },
    { "type": "range", "id": "heading_size_mobile", "label": "Tamaño del título", "min": 18, "max": 48, "step": 2, "unit": "px", "default": 28 },
    {
      "type": "select",
      "id": "heading_align_mobile",
      "label": "Alineación del título",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" }
      ],
      "default": "left"
    },
    { "type": "range", "id": "row_gap_mobile", "label": "Separación entre bloques", "min": 8, "max": 56, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "column_gap_mobile", "label": "Separación lateral interna", "min": 0, "max": 40, "step": 4, "unit": "px", "default": 16 },
    { "type": "range", "id": "foot_gap_mobile", "label": "Separación en el pie", "min": 8, "max": 32, "step": 4, "unit": "px", "default": 16 },
    {
      "type": "select",
      "id": "foot_align_mobile",
      "label": "Alineación del pie",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" }
      ],
      "default": "left"
    },
    { "type": "checkbox", "id": "button_full_mobile", "label": "Botón de ancho completo", "default": true },
    { "type": "range", "id": "padding_inline_mobile", "label": "Margen lateral", "min": 0, "max": 40, "step": 4, "unit": "px", "default": 16 },
    { "type": "range", "id": "padding_top_mobile", "label": "Espacio arriba", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Espacio abajo", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 32 },

    { "type": "header", "content": "Sección" },
    { "type": "color_background", "id": "bg_color", "label": "Fondo", "default": "#FFFFFF" },
    { "type": "checkbox", "id": "lab_grid", "label": "Retícula del lab de fondo", "default": false },
    { "type": "range", "id": "max_width", "label": "Ancho máximo", "min": 900, "max": 1600, "step": 20, "unit": "px", "default": 1200 },
    { "type": "range", "id": "padding_inline", "label": "Margen lateral (escritorio)", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_top", "label": "Espacio arriba (escritorio)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio abajo (escritorio)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 64 },
    { "type": "text", "id": "anchor_id", "label": "ID de ancla (opcional)" }
  ],
  "blocks": [
    {
      "type": "claim",
      "name": "Claim destacado",
      "settings": [
        { "type": "text", "id": "text", "label": "Texto", "default": "FORTIFICADA: HASTA 4.9X MÁS VITAMINA A, 4X MÁS B12 Y 3.6X MÁS CALCIO QUE UN HUEVO" },
        { "type": "color", "id": "bg", "label": "Fondo", "default": "#FAE64B" },
        { "type": "color", "id": "color", "label": "Texto", "default": "#000000" }
      ]
    },
    {
      "type": "button",
      "name": "Botón",
      "limit": 2,
      "settings": [
        { "type": "text", "id": "label", "label": "Texto del botón", "default": "Agregar al carrito" },
        { "type": "url", "id": "link", "label": "Enlace" },
        { "type": "range", "id": "size", "label": "Tamaño del texto", "min": 12, "max": 22, "step": 1, "unit": "px", "default": 16 },
        { "type": "color", "id": "bg", "label": "Fondo", "default": "#FAE64B" },
        { "type": "color", "id": "color", "label": "Texto", "default": "#000000" }
      ]
    },
    {
      "type": "text",
      "name": "Texto",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Proteína de almendra y huevo, sin azúcar añadida y con fibra prebiótica.</p>" },
        { "type": "range", "id": "size", "label": "Tamaño", "min": 13, "max": 22, "step": 1, "unit": "px", "default": 16 },
        { "type": "color", "id": "color", "label": "Color", "default": "#000000" }
      ]
    },
    {
      "type": "descriptor",
      "name": "Descriptor (mono)",
      "settings": [
        { "type": "text", "id": "text", "label": "Texto", "default": "250 G · 10 PORCIONES" },
        { "type": "color", "id": "color", "label": "Color", "default": "#000000" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fuly · Dos imágenes",
      "blocks": [
        { "type": "claim" },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}
