{%- comment -%}
  Seccion: Fuly Marquee aliados - "Donde comprar?"
  Fuly Kids. Titulo, texto y logos editables desde el editor de temas.
  Cada tienda es un bloque: se agrega, reordena o elimina sin tocar codigo.
{%- endcomment -%}

{%- assign uid = section.id | replace: '_', '' | replace: '-', '' | downcase -%}

<style>
  #shopify-section-{{ section.id }} .fk-marquee {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .fk-marquee__head {
    text-align: {{ section.settings.text_align }};
    max-width: 720px;
    margin: 0 auto {{ section.settings.head_gap }}px;
    padding: 0 20px;
  }
  {%- if section.settings.text_align == 'left' -%}
  #shopify-section-{{ section.id }} .fk-marquee__head { margin-left: 0; }
  {%- endif -%}

  #shopify-section-{{ section.id }} .fk-marquee__title {
    margin: 0;
    color: {{ section.settings.title_color }};
    font-size: {{ section.settings.title_size }}px;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  #shopify-section-{{ section.id }} .fk-marquee__text {
    margin: 10px 0 0;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.text_size }}px;
    line-height: 1.5;
  }
  #shopify-section-{{ section.id }} .fk-marquee__text p { margin: 0; }

  #shopify-section-{{ section.id }} .fk-marquee__viewport {
    position: relative;
    width: 100%;
    overflow: hidden;
    {% if section.settings.fade_edges %}
    -webkit-mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
            mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
    {% endif %}
  }

  #shopify-section-{{ section.id }} .fk-marquee__track {
    display: flex;
    width: max-content;
    animation: fk-scroll-{{ uid }} {{ section.settings.speed }}s linear infinite;
    {% if section.settings.direction == 'right' %}animation-direction: reverse;{% endif %}
  }
  {%- if section.settings.pause_on_hover -%}
  #shopify-section-{{ section.id }} .fk-marquee__viewport:hover .fk-marquee__track,
  #shopify-section-{{ section.id }} .fk-marquee__track:focus-within {
    animation-play-state: paused;
  }
  {%- endif -%}

  #shopify-section-{{ section.id }} .fk-marquee__group {
    display: flex;
    align-items: flex-start;
    flex: 0 0 auto;
    gap: {{ section.settings.gap }}px;
    padding-right: {{ section.settings.gap }}px;
  }

  #shopify-section-{{ section.id }} .fk-marquee__item {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: {{ section.settings.caption_gap }}px;
    width: {{ section.settings.item_width }}px;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .fk-marquee__media {
    display: flex;
    align-items: center;
    justify-content: center;
    height: {{ section.settings.logo_height }}px;
  }

  #shopify-section-{{ section.id }} .fk-marquee__item img,
  #shopify-section-{{ section.id }} .fk-marquee__item svg {
    display: block;
    width: auto;
    max-width: {{ section.settings.item_width }}px;
    height: 100%;
    max-height: {{ section.settings.logo_height }}px;
    object-fit: contain;
    opacity: {{ section.settings.logo_opacity | divided_by: 100.0 }};
    {% if section.settings.grayscale %}filter: grayscale(100%);{% endif %}
    transition: opacity .25s ease, filter .25s ease, transform .25s ease;
  }

  #shopify-section-{{ section.id }} .fk-marquee__name {
    margin: 0;
    text-align: center;
    color: {{ section.settings.name_color }};
    font-size: {{ section.settings.name_size }}px;
    line-height: 1.3;
    letter-spacing: 0.02em;
    {% if section.settings.name_uppercase %}text-transform: uppercase;{% endif %}
    {% if section.settings.name_bold %}font-weight: 600;{% endif %}
  }

  #shopify-section-{{ section.id }} a.fk-marquee__item:hover img,
  #shopify-section-{{ section.id }} a.fk-marquee__item:hover svg {
    opacity: 1;
    filter: none;
    transform: translateY(-2px);
  }
  #shopify-section-{{ section.id }} a.fk-marquee__item:hover .fk-marquee__name {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @keyframes fk-scroll-{{ uid }} {
    from { transform: translate3d(0, 0, 0); }
    to   { transform: translate3d(-50%, 0, 0); }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .fk-marquee__title { font-size: {{ section.settings.title_size | times: 0.72 | round }}px; }
    #shopify-section-{{ section.id }} .fk-marquee__text { font-size: {{ section.settings.text_size | times: 0.9 | round }}px; }
    #shopify-section-{{ section.id }} .fk-marquee__media { height: {{ section.settings.logo_height | times: 0.78 | round }}px; }
    #shopify-section-{{ section.id }} .fk-marquee__item img,
    #shopify-section-{{ section.id }} .fk-marquee__item svg { max-height: {{ section.settings.logo_height | times: 0.78 | round }}px; }
    #shopify-section-{{ section.id }} .fk-marquee__item { width: {{ section.settings.item_width | times: 0.8 | round }}px; }
    #shopify-section-{{ section.id }} .fk-marquee__item img { max-width: {{ section.settings.item_width | times: 0.8 | round }}px; }
    #shopify-section-{{ section.id }} .fk-marquee__group { gap: {{ section.settings.gap | times: 0.6 | round }}px; padding-right: {{ section.settings.gap | times: 0.6 | round }}px; }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .fk-marquee__track { animation: none; }
    #shopify-section-{{ section.id }} .fk-marquee__viewport {
      overflow-x: auto;
      -webkit-mask-image: none;
              mask-image: none;
    }
    #shopify-section-{{ section.id }} .fk-marquee__group--clone { display: none; }
  }
</style>

<div class="fk-marquee">
  {%- if section.settings.title != blank or section.settings.text != blank -%}
    <div class="fk-marquee__head">
      {%- if section.settings.title != blank -%}
        <h2 class="fk-marquee__title">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="fk-marquee__text">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="fk-marquee__viewport">
      <div class="fk-marquee__track">
        {%- for pass in (1..2) -%}
          {%- assign is_clone = false -%}
          {%- if forloop.index == 2 -%}{%- assign is_clone = true -%}{%- endif -%}

          <div class="fk-marquee__group{% if is_clone %} fk-marquee__group--clone{% endif %}"{% if is_clone %} aria-hidden="true"{% endif %}>
            {%- for block in section.blocks -%}
              {%- assign store_name = block.settings.name | default: block.settings.logo.alt -%}
              {%- assign store_alt = store_name | escape -%}
              {%- if block.settings.link != blank -%}
                <a
                  class="fk-marquee__item"
                  href="{{ block.settings.link }}"
                  {% if block.settings.new_tab %}target="_blank" rel="noopener"{% endif %}
                  {% if is_clone %}tabindex="-1"{% endif %}
                  {{ block.shopify_attributes }}
                >
              {%- else -%}
                <div class="fk-marquee__item" {{ block.shopify_attributes }}>
              {%- endif -%}

                <span class="fk-marquee__media">
                  {%- if block.settings.logo != blank -%}
                    {{ block.settings.logo | image_url: height: 300 | image_tag: loading: 'lazy', alt: store_alt, widths: '120, 180, 240, 360, 480' }}
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'fk-marquee__placeholder' }}
                  {%- endif -%}
                </span>

                {%- if section.settings.show_names and store_name != blank -%}
                  <span class="fk-marquee__name">{{ store_name }}</span>
                {%- endif -%}

              {%- if block.settings.link != blank -%}
                </a>
              {%- else -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Fuly Marquee aliados",
  "tag": "section",
  "class": "fk-marquee-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titulo",
      "default": "¿Dónde comprar?"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Conoce tu tienda más cercana</p>"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Alineacion del encabezado",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" }
      ],
      "default": "center"
    },
    { "type": "header", "content": "Animacion" },
    {
      "type": "range",
      "id": "speed",
      "label": "Duracion del ciclo (mas alto = mas lento)",
      "min": 10,
      "max": 120,
      "step": 5,
      "unit": "s",
      "default": 40
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direccion",
      "options": [
        { "value": "left", "label": "Hacia la izquierda" },
        { "value": "right", "label": "Hacia la derecha" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pausar al pasar el mouse",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "fade_edges",
      "label": "Desvanecer los bordes",
      "default": true
    },
    { "type": "header", "content": "Logos" },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Alto del logo",
      "min": 24,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "item_width",
      "label": "Ancho de cada tienda",
      "info": "Mantiene todos los logos alineados aunque tengan formas distintas.",
      "min": 80,
      "max": 320,
      "step": 10,
      "unit": "px",
      "default": 160
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Espacio entre tiendas",
      "min": 16,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "logo_opacity",
      "label": "Opacidad del logo",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "checkbox",
      "id": "grayscale",
      "label": "Logos en blanco y negro",
      "default": false
    },
    { "type": "header", "content": "Nombre debajo del logo" },
    {
      "type": "checkbox",
      "id": "show_names",
      "label": "Mostrar el nombre de la tienda",
      "default": true
    },
    {
      "type": "range",
      "id": "name_size",
      "label": "Tamano del nombre",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "name_color",
      "label": "Color del nombre",
      "default": "#4A4A4A"
    },
    {
      "type": "range",
      "id": "caption_gap",
      "label": "Espacio entre logo y nombre",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "name_uppercase",
      "label": "Nombre en mayusculas",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "name_bold",
      "label": "Nombre en negrita",
      "default": true
    },
    { "type": "header", "content": "Estilo" },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Color del titulo",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del texto",
      "default": "#5A5A5A"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Tamano del titulo",
      "min": 20,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 38
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Tamano del texto",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 17
    },
    {
      "type": "range",
      "id": "head_gap",
      "label": "Espacio entre encabezado y logos",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espaciado superior",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espaciado inferior",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Tienda",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo de la tienda"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Nombre de la tienda",
          "info": "Se muestra debajo del logo y se usa como texto alternativo de la imagen.",
          "default": "Nombre de la tienda"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace (opcional)"
        },
        {
          "type": "checkbox",
          "id": "new_tab",
          "label": "Abrir en una pestana nueva",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fuly Marquee aliados",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}