{% doc %}
  @prompt
    Una imagen de largo no tan grande como un banner
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-wide-image-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-wide-image-{{ ai_gen_id }}__inner {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-wide-image-{{ ai_gen_id }}__link,
  .ai-wide-image-{{ ai_gen_id }}__media,
  .ai-wide-image-{{ ai_gen_id }}__placeholder {
    display: block;
    width: 100%;
  }

  .ai-wide-image-{{ ai_gen_id }}__media,
  .ai-wide-image-{{ ai_gen_id }}__placeholder {
    aspect-ratio: {{ block.settings.image_ratio }};
    overflow: hidden;
    border-radius: {{ block.settings.corner_radius }}px;
    background: {{ block.settings.placeholder_color }};
  }

  .ai-wide-image-{{ ai_gen_id }}__media {
    object-fit: cover;
  }

  .ai-wide-image-{{ ai_gen_id }}__placeholder {
    position: relative;
  }

  .ai-wide-image-{{ ai_gen_id }}__placeholder svg {
    width: 100%;
    height: 100%;
    display: block;
    color: {{ block.settings.placeholder_icon_color }};
  }

  .ai-wide-image-{{ ai_gen_id }}__empty-state {
    position: absolute;
    left: 50%;
    bottom: 14px;
    transform: translateX(-50%);
    width: max-content;
    max-width: calc(100% - 28px);
    padding: 7px 12px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.9);
    color: #1a1a1a;
    font-size: 13px;
    line-height: 1.3;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-wide-image-{{ ai_gen_id }}__inner {
      width: 100%;
    }

    .ai-wide-image-{{ ai_gen_id }}__media,
    .ai-wide-image-{{ ai_gen_id }}__placeholder {
      aspect-ratio: {{ block.settings.mobile_ratio }};
    }
  }
{% endstyle %}

<div class="ai-wide-image-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-wide-image-{{ ai_gen_id }}__inner">
    {% if block.settings.image != blank %}
      {% if block.settings.image_link != blank %}
        <a
          class="ai-wide-image-{{ ai_gen_id }}__link"
          href="{{ block.settings.image_link }}"
          aria-label="{{ block.settings.image_alt | escape }}"
        >
      {% endif %}

      <img
        class="ai-wide-image-{{ ai_gen_id }}__media"
        src="{{ block.settings.image | image_url: width: 1800 }}"
        srcset="{{ block.settings.image | image_url: width: 600 }} 600w, {{ block.settings.image | image_url: width: 900 }} 900w, {{ block.settings.image | image_url: width: 1200 }} 1200w, {{ block.settings.image | image_url: width: 1800 }} 1800w"
        sizes="(max-width: 749px) 100vw, {{ block.settings.desktop_width_percent }}vw"
        alt="{{ block.settings.image_alt | default: block.settings.image.alt | escape }}"
        width="{{ block.settings.image.width }}"
        height="{{ block.settings.image.height }}"
        loading="lazy"
      >

      {% if block.settings.image_link != blank %}
        </a>
      {% endif %}
    {% else %}
      <div class="ai-wide-image-{{ ai_gen_id }}__placeholder">
        {{ 'image' | placeholder_svg_tag }}
        <div class="ai-wide-image-{{ ai_gen_id }}__empty-state">Agrega una imagen horizontal</div>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Imagen horizontal",
  "settings": [
    {
      "type": "header",
      "content": "Imagen"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Texto alternativo",
      "default": "Imagen de Fuly Kids"
    },
    {
      "type": "url",
      "id": "image_link",
      "label": "Enlace"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Proporción en escritorio",
      "options": [
        { "value": "3 / 1", "label": "Muy horizontal" },
        { "value": "2 / 1", "label": "Horizontal" },
        { "value": "16 / 9", "label": "Panorámica" }
      ],
      "default": "2 / 1"
    },
    {
      "type": "select",
      "id": "mobile_ratio",
      "label": "Proporción en móvil",
      "options": [
        { "value": "2 / 1", "label": "Horizontal" },
        { "value": "16 / 9", "label": "Panorámica" },
        { "value": "4 / 3", "label": "Compacta" }
      ],
      "default": "16 / 9"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Ancho en escritorio",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Redondeado",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "placeholder_color",
      "label": "Fondo sin imagen",
      "default": "#f9ecbf"
    },
    {
      "type": "color",
      "id": "placeholder_icon_color",
      "label": "Ícono sin imagen",
      "default": "#574ddf"
    }
  ],
  "presets": [
    {
      "name": "Imagen horizontal"
    }
  ],
  "tag": null,
  "class": "wide-image-block"
}
{% endschema %}