{% doc %}
  @prompt
    Necesito una sección tipo multicolumna en donde pueda poner 3 videos, que también este optimizado para movil, y pueda configurar cuantos videos aparecen en la grilla, Cada video debe medir lo que mide un video de redes sociales es decir 1080x1920px, se le está cambiando el tamaño al video cargado originalmente en shopify. Como si fuera más grande que el espacio pero en realidad tiene el tamaño de redes sociales. Además está dejando mucho espacio abajo como si fuera un bug, No sirve nada gracias por nada
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-grid-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 40px 20px;
  }

  .ai-video-grid-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
  }

  .ai-video-grid-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: 32px;
  }

  .ai-video-grid-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 12px 0;
  }

  .ai-video-grid-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    margin: 0;
  }

  .ai-video-grid-items-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.gap }}px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ai-video-grid-item-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
    background-color: {{ block.settings.video_bg_color }};
  }

  .ai-video-grid-video-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-video-grid-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-video-grid-placeholder-{{ ai_gen_id }} svg {
    width: 60px;
    height: 60px;
    opacity: 0.3;
  }

  @media screen and (max-width: 749px) {
    .ai-video-grid-items-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-video-grid-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-video-grid-description-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.description_size }}px * 0.9);
    }
  }
{% endstyle %}

<div class="ai-video-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-video-grid-container-{{ ai_gen_id }}">
    {% if block.settings.title != blank or block.settings.description != blank %}
      <div class="ai-video-grid-header-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-video-grid-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}
        {% if block.settings.description != blank %}
          <div class="ai-video-grid-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
        {% endif %}
      </div>
    {% endif %}

    <ul class="ai-video-grid-items-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% assign video_key = 'video_' | append: i %}
        {% assign video = block.settings[video_key] %}
        
        <li class="ai-video-grid-item-{{ ai_gen_id }}">
          {% if video != blank %}
            {{
              video
              | video_tag:
                image_size: '1080x',
                autoplay: block.settings.autoplay,
                loop: block.settings.loop,
                controls: block.settings.controls,
                muted: block.settings.muted,
                class: 'ai-video-grid-video-' | append: ai_gen_id
            }}
          {% else %}
            <div class="ai-video-grid-placeholder-{{ ai_gen_id }}">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Video grid",
  "settings": [
    {
      "type": "header",
      "content": "Contenido"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Nuestros videos"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Descripción"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alineación de texto",
      "options": [
        {
          "value": "left",
          "label": "Izquierda"
        },
        {
          "value": "center",
          "label": "Centro"
        },
        {
          "value": "right",
          "label": "Derecha"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Videos"
    },
    {
      "type": "video",
      "id": "video_1",
      "label": "Video 1"
    },
    {
      "type": "video",
      "id": "video_2",
      "label": "Video 2"
    },
    {
      "type": "video",
      "id": "video_3",
      "label": "Video 3"
    },
    {
      "type": "video",
      "id": "video_4",
      "label": "Video 4"
    },
    {
      "type": "video",
      "id": "video_5",
      "label": "Video 5"
    },
    {
      "type": "video",
      "id": "video_6",
      "label": "Video 6"
    },
    {
      "type": "header",
      "content": "Configuración de video"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Reproducción automática",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Repetir en bucle",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "controls",
      "label": "Mostrar controles",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "muted",
      "label": "Silenciar",
      "default": true,
      "info": "Requerido para reproducción automática"
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columnas en escritorio",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columnas en móvil",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Espacio entre videos",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Ancho máximo",
      "min": 800,
      "max": 1600,
      "step": 100,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Radio de borde",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Color del título",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Color de descripción",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "video_bg_color",
      "label": "Color de fondo de video",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Tipografía"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Tamaño del título",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Tamaño de descripción",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Video grid"
    }
  ]
}
{% endschema %}