{% doc %}
  @prompt
    Necesito una sección tipo multicolumna en donde pueda poner 3 videos, que también este optimizado para movil, y pueda configurar cuantos videos aparecen en la grilla, Cada video debe medir lo que mide un video de redes sociales es decir 1080x1920px, se le está cambiando el tamaño al video cargado originalmente en shopify. Como si fuera más grande que el espacio pero en realidad tiene el tamaño de redes sociales. Además está dejando mucho espacio abajo como si fuera un bug
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-grid-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-video-grid__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-video-grid__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
  }

  .ai-video-grid__title-{{ ai_gen_id }} {
    margin: 0 0 12px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-video-grid__description-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.description_size }}px;
  }

  .ai-video-grid__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-video-grid__item-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    border-radius: {{ block.settings.video_border_radius }}px;
    overflow: hidden;
    background-color: {{ block.settings.video_background }};
  }

  .ai-video-grid__video-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 16;
    overflow: hidden;
  }

  .ai-video-grid__video-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .ai-video-grid__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-video-grid__placeholder-{{ ai_gen_id }} svg {
    width: 80px;
    height: 80px;
    opacity: 0.3;
  }

  .ai-video-grid__caption-{{ ai_gen_id }} {
    padding: 16px;
    text-align: {{ block.settings.caption_alignment }};
  }

  .ai-video-grid__caption-title-{{ ai_gen_id }} {
    margin: 0 0 8px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.caption_title_size }}px;
    font-weight: 600;
  }

  .ai-video-grid__caption-text-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.caption_text_size }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-video-grid__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.grid_gap_mobile }}px;
    }

    .ai-video-grid__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-video-grid__description-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.description_size }}px * 0.9);
    }
  }
{% endstyle %}

<video-grid-{{ ai_gen_id }} class="ai-video-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-video-grid__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.description != blank %}
      <div class="ai-video-grid__header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-video-grid__title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.description != blank %}
          <div class="ai-video-grid__description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-video-grid__grid-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign video_key = 'video_' | append: i
          assign title_key = 'video_' | append: i | append: '_title'
          assign caption_key = 'video_' | append: i | append: '_caption'
          assign video = block.settings[video_key]
          assign title = block.settings[title_key]
          assign caption = block.settings[caption_key]
        %}

        <div class="ai-video-grid__item-{{ ai_gen_id }}">
          <div class="ai-video-grid__video-wrapper-{{ ai_gen_id }}">
            {% if video %}
              {{
                video
                | video_tag:
                  image_size: '1100x',
                  autoplay: block.settings.autoplay,
                  loop: block.settings.loop,
                  controls: block.settings.show_controls,
                  muted: block.settings.muted,
                  class: 'ai-video-grid__video-' | append: ai_gen_id
              }}
            {% else %}
              <div class="ai-video-grid__placeholder-{{ ai_gen_id }}">
                {{ 'collection-apparel-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          {% if title != blank or caption != blank %}
            <div class="ai-video-grid__caption-{{ ai_gen_id }}">
              {% if title != blank %}
                <h3 class="ai-video-grid__caption-title-{{ ai_gen_id }}">{{ title }}</h3>
              {% endif %}
              {% if caption != blank %}
                <div class="ai-video-grid__caption-text-{{ ai_gen_id }}">{{ caption }}</div>
              {% endif %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</video-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class VideoGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.videos = this.querySelectorAll('.ai-video-grid__video-{{ ai_gen_id }}');
        this.setupVideoObserver();
      }

      setupVideoObserver() {
        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                const video = entry.target;
                if (entry.isIntersecting) {
                  if (video.paused && video.hasAttribute('autoplay')) {
                    video.play().catch(() => {});
                  }
                } else {
                  if (!video.paused) {
                    video.pause();
                  }
                }
              });
            },
            { threshold: 0.5 }
          );

          this.videos.forEach((video) => {
            observer.observe(video);
          });
        }
      }
    }

    customElements.define('video-grid-{{ ai_gen_id }}', VideoGrid{{ ai_gen_id }});
  })();
</script>

